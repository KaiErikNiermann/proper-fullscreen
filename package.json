{
  "name": "proper-fullscreen",
  "version": "0.1.0",
  "description": "Removes baked-in letterbox bars so scope films fill an ultrawide display.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiErikNiermann/proper-fullscreen.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test test/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "start:firefox": "pnpm build && web-ext run --source-dir . --target firefox-desktop",
    "package": "pnpm build && web-ext build --source-dir . --overwrite-dest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "ts-api-utils": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "web-ext": "^10.6.0"
  }
}
